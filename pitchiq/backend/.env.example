# PitchIQ Backend Configuration
PITCHIQ_DATABASE_URL=postgresql://pitchiq:pitchiq@localhost:5432/pitchiq
PITCHIQ_REDIS_URL=redis://localhost:6379/0
PITCHIQ_DEBUG=true
PITCHIQ_UPLOAD_DIR=data/uploads
PITCHIQ_PROCESSED_DIR=data/processed
PITCHIQ_FRAMES_DIR=data/frames
PITCHIQ_MAX_UPLOAD_SIZE_MB=5120
PITCHIQ_DEFAULT_DETECTION_FPS=2.0
PITCHIQ_YOLO_MODEL_PATH=yolov8x.pt
